# 把下面复制到你自己的 .env (不要提交到 git), 或直接 export 环境变量

# TradingView alert 里要带的密钥, 自己编一个长随机串, 两边保持一致
WEBHOOK_SECRET=换成你自己的随机长字符串

# Schwab developer app 的 key/secret (developer.schwab.com 注册后拿到)
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=

# true = 只记录不真下单(先用这个测试); 确认无误后改 false
DRY_RUN=true

# 只允许交易的标的, 逗号分隔, 为空=不限制(不推荐)
SYMBOL_ALLOWLIST=

# 单笔订单金额上限(美元), 超过会拒绝
MAX_DOLLARS_PER_ORDER=2000
